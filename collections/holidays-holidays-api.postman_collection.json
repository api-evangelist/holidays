        {
          "id": "ce8fd78b-ca77-440c-a762-139650fd2f56",
          "name": "List Holidays",
          "request": {
            "name": "List Holidays",
            "description": {
              "content": "Retrieves a list of public holidays and observances for countries, states and provinces.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "holidays"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "key",
                  "value": "<uuid>",
                  "description": "(Required) Your API key."
                },
                {
                  "disabled": false,
                  "key": "country",
                  "value": "<string>",
                  "description": "(Required) For countries, ISO 3166-1 alpha-2 or ISO 3166-1 alpha-3 format. For subdivisions, ISO 3166-2 format. Accepts up to 10 comma separated values."
                },
                {
                  "disabled": false,
                  "key": "year",
                  "value": "<integer>",
                  "description": "(Required) ISO 8601 format"
                },
                {
                  "disabled": false,
                  "key": "month",
                  "value": "<integer>",
                  "description": "1 or 2 digit month (1-12)"
                },
                {
                  "disabled": false,
                  "key": "day",
                  "value": "<integer>",
                  "description": "1 or 2 digit day (1-31 depending on the month). Must be used with month."
                },
                {
                  "disabled": false,
                  "key": "public",
                  "value": "false",
                  "description": "Return only public holidays."
                },
                {
                  "disabled": false,
                  "key": "subdivisions",
                  "value": "false",
                  "description": "Return state / province holidays alongside countrywide holidays. Available on our States & Provinces plan."
                },
                {
                  "disabled": false,
                  "key": "search",
                  "value": "<string>",
                  "description": "Search holidays by name."
                },
                {
                  "disabled": false,
                  "key": "language",
                  "value": "<string>",
                  "description": "ISO 639-1 format (with exceptions)."
                },
                {
                  "disabled": false,
                  "key": "previous",
                  "value": "<boolean>",
                  "description": "Return the first day of holidays that occur before the specific date. month and day are required. Cannot be used with upcoming."
                },
                {
                  "disabled": false,
                  "key": "upcoming",
                  "value": "<boolean>",
                  "description": "Return the first day of holidays that occur after the specific date. month and day are required. Cannot be used with previous."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Response format."
                },
                {
                  "disabled": false,
                  "key": "pretty",
                  "value": "false",
                  "description": "Prettifies results to be more human-readable."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
